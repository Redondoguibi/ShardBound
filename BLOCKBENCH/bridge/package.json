{
  "name": "shardbound-blockbench-bridge",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:paired": "node scripts/build.mjs --paired",
    "setup": "node scripts/setup.mjs",
    "start": "node mcp/server.mjs",
    "http": "node mcp/server.mjs --http",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "stop": "node scripts/stop.mjs",
    "tunnel:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-TunnelClient.ps1",
    "tunnel:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Configure-SecureTunnel.ps1",
    "tunnel:connect": "powershell -NoProfile -ExecutionPolicy Bypass -File Connect-ChatGPT.ps1",
    "tunnel:status": "powershell -NoProfile -ExecutionPolicy Bypass -File Status-ChatGPT.ps1",
    "tunnel:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File Disconnect-ChatGPT.ps1",
    "chatgpt:start": "powershell -NoProfile -ExecutionPolicy Bypass -File Connect-ChatGPT.ps1",
    "chatgpt:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File Disconnect-ChatGPT.ps1",
    "chatgpt:status": "powershell -NoProfile -ExecutionPolicy Bypass -File Status-ChatGPT.ps1",
    "chatgpt:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File Status-ChatGPT.ps1 -Verify",
    "chatgpt:legacy:start": "node scripts/chatgpt.mjs start",
    "chatgpt:legacy:stop": "node scripts/chatgpt.mjs stop",
    "chatgpt:legacy:status": "node scripts/chatgpt.mjs status",
    "chatgpt:legacy:verify": "node scripts/verify-chatgpt.mjs",
    "test:blockbench": "node scripts/test-blockbench.mjs",
    "package": "powershell -NoProfile -File scripts/package.ps1",
    "package:desktop": "powershell -NoProfile -File scripts/package.ps1 -BindCurrentMachine"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^5.1.0",
    "ws": "^8.22.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.0"
  }
}
